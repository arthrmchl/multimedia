# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Base de test : PostgreSQL local (brew services start postgresql@17), jamais Supabase.
# Doctrine ajoute le suffixe « _test » : la base réelle s'appelle app_test.
# .env.local n'est pas chargé en environnement de test, donc pas de risque de viser Supabase.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/app?serverVersion=17&charset=utf8"
